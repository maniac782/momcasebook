rules_version = '2';
// Mansions of Madness Casebook: who can read and write what. The pages hide what people can't do, but these rules
// are what actually enforce it. Published by the GitHub workflow on every push to main.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    // Admins have a document admins/{their uid}, made by hand in the Firebase console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, n) { return v is string && v.size() <= n; }
    function num(v) { return v is int || v is float; }
    function optStr(d, k, n) { return !(k in d) || str(d[k], n); }
    function optNum(d, k) { return !(k in d) || num(d[k]); }

    // The official investigators (same list as js/catalog.js; test/house-rules.test.js checks they match).
    function investigators() {
      return ['Agatha Crane', 'Carson Sinclair', 'Father Mateo', 'Minh Thi Phan', 'Preston Fairmont', 'Rita Young', 'Wendy Adams', 'William Yorick', '"Ashcan" Pete', 'Gloria Goldberg', 'Harvey Walters', 'Jenny Barnes', 'Joe Diamond', 'Kate Winthrop', 'Michael McGlen', 'Sister Mary', 'Amanda Sharpe', 'Bob Jenkins', 'Carolyn Fern', 'Darrell Simmons', 'Dexter Drake', 'Mandy Thompson', 'Monterey Jack', 'Vincent Lee', 'Akachi Onyele', 'Wilson Richards', 'Diana Stanley', 'Finn Edwards', 'Marie Lambeau', 'Tommy Muldoon', 'Charlie Kane', 'Lily Chen', 'Agnes Baker', 'Jim Culver', 'Silas Marsh', 'Trish Scarborough', 'Daniela Reyes', 'Leo Anderson', 'Norman Withers', 'Ursula Downs'];
    }
    // A seat: a player's name (free text) and an official investigator, or '' when not recorded.
    function seatOk(s) {
      return s is map && s.keys().hasOnly(['player','investigator']) && str(s.player, 40)
        && s.investigator is string && (s.investigator == '' || s.investigator in investigators());
    }
    function partyOk(p) {
      return p is list && p.size() <= 8
        && (p.size() < 1 || seatOk(p[0])) && (p.size() < 2 || seatOk(p[1])) && (p.size() < 3 || seatOk(p[2]))
        && (p.size() < 4 || seatOk(p[3])) && (p.size() < 5 || seatOk(p[4])) && (p.size() < 6 || seatOk(p[5]))
        && (p.size() < 7 || seatOk(p[6])) && (p.size() < 8 || seatOk(p[7]));
    }

    function validPlay(d) {
      return d.keys().hasOnly(['scenarioId','scenarioName','scenarioType','date','result','attempts','party','solo','rules','notes',
                               'created','updated','importKey','seq','location'])
        && str(d.scenarioId, 100) && d.scenarioId.size() > 0 && str(d.scenarioName, 100)
        // only official and Valkyrie scenarios (ids o-… and v-…); custom scenarios can't be saved
        && d.scenarioType in ['official','valkyrie'] && d.scenarioId.matches('(o|v)-[a-z0-9-]+')
        && str(d.date, 10) && (d.date == '' || d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.result in ['pass','fail','abandoned']
        && d.attempts is int && d.attempts >= 1 && d.attempts <= 99
        && partyOk(d.party)
        && d.solo is bool && str(d.rules, 80) && str(d.notes, 4000) && optStr(d, 'location', 60)
        && optNum(d, 'created') && optNum(d, 'updated') && optStr(d, 'importKey', 40) && (!('seq' in d) || d.seq is int);
    }
    function validScenario(d) {
      return d.keys().hasOnly(['name','type','author','link','created','by'])
        && str(d.name, 80) && d.name.size() > 0 && d.type in ['official','valkyrie']
        && optStr(d, 'author', 60) && optStr(d, 'link', 300) && (!('link' in d) || d.link == '' || d.link.matches('https://.*'))
        && optNum(d, 'created') && optStr(d, 'by', 128);
    }

    // Each person's profile and log: only they can see or change them. Admins can read profiles (not plays).
    match /users/{uid} {
      allow read: if own(uid) || isAdmin();
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['name','email','created','lastSeen','playCount','owned','hideValkyrie','photo'])
        && optStr(request.resource.data, 'name', 40) && optStr(request.resource.data, 'email', 200)
        && optNum(request.resource.data, 'created') && optNum(request.resource.data, 'lastSeen') && optNum(request.resource.data, 'playCount')
        // profile picture: a small JPEG written by js/shared.js (choosePicture), or '' for none
        && (!('photo' in request.resource.data) || request.resource.data.photo == ''
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 60000
                && request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && (!('hideValkyrie' in request.resource.data) || request.resource.data.hideValkyrie is bool)
        && (!('owned' in request.resource.data) || (request.resource.data.owned is list && request.resource.data.owned.size() <= 40));
      allow delete: if own(uid);

      match /plays/{pid} {
        allow read, delete: if own(uid);
        allow create, update: if own(uid) && validPlay(request.resource.data);
      }
      // personal scenarios from older versions: readable and removable, never created any more
      match /scenarios/{sid} {
        allow read, delete: if own(uid);
      }
      // regular players (just names; they don't need accounts) and groups of them
      match /people/{pid} {
        allow read, delete: if own(uid);
        allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['name','notes','created','updated'])
          && str(request.resource.data.name, 40) && request.resource.data.name.size() > 0
          && optStr(request.resource.data, 'notes', 500) && optNum(request.resource.data, 'created') && optNum(request.resource.data, 'updated');
      }
      match /groups/{gid} {
        allow read, delete: if own(uid);
        allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['name','members','created','updated'])
          && str(request.resource.data.name, 40) && request.resource.data.name.size() > 0
          && request.resource.data.members is list && request.resource.data.members.size() <= 30
          && optNum(request.resource.data, 'created') && optNum(request.resource.data, 'updated');
      }
    }

    // Scenarios the admin shares with everyone (mostly Valkyrie ones).
    match /scenarios/{sid} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validScenario(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if own(uid);
    }

    // Send feedback: anyone signed in can add; only admins read, mark done or delete.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind','msg','page','ua','v','t','uid','name','done'])
        && request.resource.data.kind in ['bug','idea','other'] && str(request.resource.data.msg, 3000)
        && request.resource.data.done == false;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
    }

    // Errors recorded by js/config.js while someone is signed in; only admins read or clear them.
    match /errors/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['msg','stack','page','ua','v','t','uid'])
        && str(request.resource.data.msg, 500) && str(request.resource.data.stack, 2000);
      allow read, delete: if isAdmin();
    }
  }
}
